<?xml version="1.0" encoding="utf-8"?><!--
   Cloud backup (Android 12+) rules.

   app_prefs.xml is excluded on purpose: it contains the remote host-mode
   pairing token (a per-install secret that must not silently travel to
   another device via backup/restore) and local feature toggles that are
   trivially re-derived. Everything else (history DB, preferences for UI
   state) is user content and intentionally backed up.

   Ignored for devices older than API 31; devices on API 28-30 use
   backup_rules.xml below.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
